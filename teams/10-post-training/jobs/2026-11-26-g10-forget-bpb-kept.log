## 3. base store record, then the script in fp32 and bf16
set -e
T=<IN>/tokenizer/tokenizer.json; BT=<LAB>/teams/04-ke2/results/tables/p1536-s0/raw_table_P32.npz
H=<RUN>/inputs/heldout_slice.jsonl; HS=<RUN>/inputs/heldout_slice_sources.jsonl; C=teams/10-post-training/capstone
echo "== delivered files without checkpoint.pt, then the store record for the base"
mkdir <RUN>/delivered && cp <RUN>/standin/{manifest.json,summary.json,metrics.jsonl,losses.txt,total_losses.txt} <RUN>/delivered/
python $C/run_folder_from_store.py --g5-root <LAB> --run-folder <RUN>/delivered --store <RUN>/store --tokenizer $T --byte-table $BT \
  --heldout-data $H --heldout-sources $HS --device cpu --out <RUN>/from_store
for D in float32 bfloat16; do
  echo "== forget_bpb_kept.py $D"
  /usr/bin/time -f "wall %e s, peak %M KB" python $C/forget_bpb_kept.py --adapter-config <RUN>/out/adapter.yaml --heldout $H \
    --heldout-sources $HS --base-store-record <RUN>/from_store/G10_FROM_STORE.json \
    --kept <RUN>/keep_t7/g10-dr2-full --kept <RUN>/keep_t7/g10-dr2-lora --kept <RUN>/keep_t7/g10-dr2-dt \
    --device cpu --dtype $D --out-dir <RUN>/forget_$D
done
